# Шаблон локальних змінних. Скопіюйте у .env.local — .env* у .gitignore.
#
# УВАГА: Create React App запікає ВСЕ, що починається з REACT_APP_, у публічний
# бандл. Це не місце для секретів — лише для того, що й так призначене браузеру.

# Ключ Google Maps JavaScript API. Обовʼязковий: без нього мапа не відрендериться.
# Обмежте його за HTTP-реферером і за переліком API в Google Cloud Console.
REACT_APP_API_KEY_MAP=

# OAuth 2.0 client id для входу через Google. Потрібен лише для сценаріїв з
# акаунтом (обране, «мої відгуки»).
REACT_APP_API_KEY_AUTH=

# База API. Дефолт у коді — бойовий https://api.navernyborshchu.com/api,
# тож локальний бекенд треба вказати явно.
REACT_APP_API_URL=http://localhost:8000/api

# Дизайн-варіант. У проді стоїть map1.
REACT_APP_VARIANT=map1

# Арм нижньої навігації: wide (прод) або compact (дев-сайт).
REACT_APP_NAV=wide

# Шкала оцінювання: 10 (стрічка 1–10) або 5 (пʼять словесних відповідей).
REACT_APP_RATE_SCALE=10
